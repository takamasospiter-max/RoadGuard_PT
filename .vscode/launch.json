{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        
        {
            // Debug run on the phone, connected to the RoadGuard backend on this
            // PC. The phone reaches it at its own 127.0.0.1:8000 through the ADB
            // tunnel (Mobile app/tool/connect_wifi.ps1). Without this
            // --dart-define the app shows "Account connection is not configured".
            "name": "Mobile app",
            "cwd": "Mobile app",
            "request": "launch",
            "type": "dart",
            "toolArgs": [
                "--dart-define=ROADGUARD_API_URL=http://127.0.0.1:8000"
            ]
        },
        {
            "name": "Mobile app (profile mode)",
            "cwd": "Mobile app",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile"
        },
        {
            "name": "Mobile app (release mode)",
            "cwd": "Mobile app",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release"
        },
        {
            "name": ".widget_preview",
            "cwd": "Mobile app\\.widget_preview",
            "request": "launch",
            "type": "dart"
        },
        {
            "name": ".widget_preview (profile mode)",
            "cwd": "Mobile app\\.widget_preview",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile"
        },
        {
            "name": ".widget_preview (release mode)",
            "cwd": "Mobile app\\.widget_preview",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release"
        }
    ]
}