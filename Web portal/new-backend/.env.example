DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=roadguard_dev
DB_USER=roadguard
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Base URL of the React app, used in invitation-email activation links
FRONTEND_URL=http://localhost:5173
# The one base path of every backend URL (config/urls.py): http://<server>/api/v1/...
# Change VITE_API_URL (website) and apiPrefix (app) with it.
ROADGUARD_API_PREFIX=api/v1
# Set to True when served over HTTPS (session cookie sent over HTTPS only)
DJANGO_SECURE_COOKIES=False
# Login / MFA / activation attempts allowed per IP address
AUTH_RATE_LIMIT=10/minute

# --- Mobile app: external map services (place search, road names, routes) ---
ROADGUARD_PHOTON_URL=https://photon.komoot.io
ROADGUARD_OSRM_URL=https://router.project-osrm.org
ROADGUARD_REVERSE_GEOCODE=True

# --- AI engine socket ---
# In-process engine class:
#   ai_engine.sensor_model.PotholeEngine = the AI team's sensor model (ai_engine/models/MODEL.md)
#   detection.engine.NullEngine          = placeholder that finds nothing
ROADGUARD_AI_ENGINE=ai_engine.sensor_model.PotholeEngine
# True = analyse each sensor batch as soon as it's uploaded
# (otherwise run: python manage.py process_telemetry --loop 10)
ROADGUARD_AI_PROCESS_INLINE=True
# Sensor model settings (defaults shown; see config/settings.py):
# ROADGUARD_AI_ACCEL_KIND=acceleration       # raw accelerometer, gravity included (as in training)
# ROADGUARD_AI_ALIGN_GRAVITY=True            # turn windows to the training phone orientation
# ROADGUARD_AI_MODEL_PATH=ai_engine/models/pothole_model_bundle.pkl
# ROADGUARD_AI_MODEL_SHA256=2c2e9ec7bdc05113b4058419bf398d207097eae0bb413f003460d00b1810d3bc
# API key for an external AI service (empty = /api/v1/ai/ endpoints disabled)
ROADGUARD_AI_API_KEY=

# --- Crowd sensing ---
SPOT_RADIUS_M=15
SPOT_MIN_CONFIDENCE=0.5
SPOT_MIN_DEVICES_TO_TRACK=2
SPOT_MIN_DEVICES_TO_PUBLISH=3
SPOT_STALE_DAYS=30
ROADGUARD_PUBLISH_SIMULATED=False
