# Settings for the Docker setup (docker-compose.yml). Copy to docker/.env;
# docker\init-env.ps1 does that and fills in the secrets for you.
# docker/.env holds passwords: it is git-ignored, never commit it.

# --- Django -------------------------------------------------------------
# Keep the same key as Web portal/new-backend/.env: it also makes the
# anonymous phone ids that crowd sensing counts, and signs invitations.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SECURE_COOKIES=False
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
FRONTEND_URL=http://localhost:8000
ROADGUARD_API_PREFIX=api/v1
AUTH_RATE_LIMIT=10/minute

# --- Database -------------------------------------------------------------
# The backend reads DB_*; the PostGIS container reads POSTGRES_*.
# Keep each pair identical (init-env.ps1 does).
DB_NAME=roadguard
DB_USER=roadguard
DB_PASSWORD=change-me
POSTGRES_DB=roadguard
POSTGRES_USER=roadguard
POSTGRES_PASSWORD=change-me

# --- Map services ---------------------------------------------------------
ROADGUARD_PHOTON_URL=https://photon.komoot.io
ROADGUARD_OSRM_URL=https://router.project-osrm.org
ROADGUARD_REVERSE_GEOCODE=True

# --- AI -------------------------------------------------------------------
ROADGUARD_AI_ENGINE=ai_engine.sensor_model.PotholeEngine
ROADGUARD_AI_PROCESS_INLINE=True
ROADGUARD_AI_API_KEY=
ROADGUARD_PHOTO_CHECK=True

# --- Crowd sensing --------------------------------------------------------
SPOT_RADIUS_M=15
SPOT_MIN_CONFIDENCE=0.5
SPOT_MIN_DEVICES_TO_TRACK=2
SPOT_MIN_DEVICES_TO_PUBLISH=3
SPOT_STALE_DAYS=30
ROADGUARD_PUBLISH_SIMULATED=False
